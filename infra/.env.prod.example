# FirstFrame production settings. On the VM:
#   cp .env.prod.example /opt/firstframe/.env && chmod 600 /opt/firstframe/.env
# then fill in every CHANGE_ME. Never commit the filled-in file.
#
# Generate secrets ON THE VM (or any Linux/macOS terminal):
#   openssl rand -hex 32        -> 64 hex chars (safe inside URLs; use for passwords)
#   openssl rand -base64 48     -> 64 chars (use for JWT / signing secrets)
# Each secret must be different. The API refuses to start in production if a
# secret is missing or shorter than 32 characters.

# ---------- Domains and TLS (Caddy) ----------
# Both must point at the VM's public IP (A records). See docs/DEPLOYMENT.md.
WEB_DOMAIN=firstframe.example.in
API_DOMAIN=api.firstframe.example.in
# Let's Encrypt sends certificate-expiry warnings here.
ACME_EMAIL=you@example.com

# ---------- Images (set by the deploy workflow; set by hand for manual deploys) ----------
# ghcr.io/<your GitHub username or org, lowercase>
IMAGE_PREFIX=ghcr.io/CHANGE_ME
# "latest" or a commit SHA (deploy.yml pins the exact SHA it built)
IMAGE_TAG=latest

# ---------- PostgreSQL (internal only, never published) ----------
POSTGRES_USER=firstframe
# openssl rand -hex 32   (hex only: it goes inside DATABASE_URL, so no / + = characters)
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=firstframe
DATABASE_POOL_SIZE=10

# ---------- Auth and signing (openssl rand -base64 48, each one different) ----------
JWT_ACCESS_SECRET=CHANGE_ME
SIGNING_SECRET=CHANGE_ME
# Shared between the API/worker and the verifier (X-Internal-Token header). openssl rand -hex 32
INTERNAL_TOKEN=CHANGE_ME
JWT_ACCESS_TTL_SEC=900
REFRESH_TTL_DAYS=7
# Cookies are Secure automatically in production. Leave COOKIE_DOMAIN empty:
# the refresh cookie belongs to API_DOMAIN, and WEB_DOMAIN is on the same site.
# COOKIE_DOMAIN=

# ---------- Storage ----------
# local = originals AND previews on the VM's disk (the "mediadata" volume). Recommended
#         for the free plan: 200 GB of disk vs R2's 10 GB free.
# s3    = EVERYTHING (originals too) goes to Cloudflare R2. Only switch when you
#         have budget for R2 beyond 10 GB, or when you outgrow the VM disk.
STORAGE_DRIVER=local
# S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=firstframe-media
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true

# ---------- Uploads and processing ----------
MAX_VIDEO_BYTES=524288000
MAX_PHOTO_BYTES=26214400
MAX_VIDEO_DURATION_SEC=600
PREVIEW_MAX_SECONDS=30
# One ffmpeg job at a time: the VM has only 2 cores.
WORKER_CONCURRENCY=1
# false = skip the ~350 MB AI model (saves ~1 GB RAM; AI score shows "unavailable")
AI_MODEL_ENABLED=true

# ---------- Payments (Razorpay) ----------
# Start with TEST keys (rzp_test_...). Switch to live keys only after Razorpay
# activates your account (docs/DEPLOYMENT.md, "Going live with Razorpay").
# PAYMENTS_PROVIDER=mock is refused in production.
PAYMENTS_PROVIDER=razorpay
RAZORPAY_KEY_ID=rzp_test_CHANGE_ME
RAZORPAY_KEY_SECRET=CHANGE_ME
# The secret you type when creating the webhook in the Razorpay dashboard.
RAZORPAY_WEBHOOK_SECRET=CHANGE_ME
PLATFORM_FEE_PERCENT=30
MIN_PAYOUT_PAISE=10000

# ---------- First admin (used once by: docker compose run --rm seed) ----------
ADMIN_EMAIL=you@example.com
# At least 12 characters. Remove it from this file after seeding.
ADMIN_PASSWORD=CHANGE_ME
ADMIN_NAME=FirstFrame Admin

# ---------- Backups to Cloudflare R2 (scripts/backup-db.sh, run by cron) ----------
# Use a SEPARATE bucket and an R2 API token scoped to "Object Read & Write" on it only.
BACKUP_S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
BACKUP_S3_BUCKET=firstframe-backups
BACKUP_S3_ACCESS_KEY_ID=CHANGE_ME
BACKUP_S3_SECRET_ACCESS_KEY=CHANGE_ME
# Keep this many days of nightly dumps (in R2 and in /var/backups/firstframe).
BACKUP_RETENTION_DAYS=14
