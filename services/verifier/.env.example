# Copy to .env for local runs. Never commit the real token.
# Must equal INTERNAL_TOKEN in apps/api/.env. This is the shared DEVELOPMENT value (also used
# by docker-compose.yml); an empty token makes the verifier reject every call.
# Production: one value from `openssl rand -hex 32`, set for the API, worker and verifier.
INTERNAL_TOKEN=dev-only-internal-token-change-me-0123456789
AI_MODEL_ENABLED=false
AI_MODEL_ID=dima806/ai_vs_human_generated_image_detection
AI_MODEL_REVISION=341594f2b003d185db789becf48a2286c177b926
MAX_FRAMES=16
MAX_FRAME_BYTES=8388608
MAX_ORIGINAL_BYTES=52428800
LOG_LEVEL=INFO
