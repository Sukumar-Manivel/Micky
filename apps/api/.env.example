# Copy to .env for local development: cp .env.example .env
NODE_ENV=development
PORT=4000
PUBLIC_API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

DATABASE_URL=postgresql://firstframe:firstframe@localhost:5432/firstframe
REDIS_URL=redis://localhost:6379

# Generate real secrets for production with: openssl rand -base64 48
# Empty = a fixed insecure development value (refused when NODE_ENV=production).
JWT_ACCESS_SECRET=
SIGNING_SECRET=
# Shared with the verifier (services/verifier/.env.example has the SAME dev value).
# If the two differ, or this is empty, every verifier call gets 401 and uploads are
# published without AI or C2PA results. Production: openssl rand -hex 32, set on both.
INTERNAL_TOKEN=dev-only-internal-token-change-me-0123456789

# Sessions: a refresh token expires after REFRESH_TTL_DAYS without use, and every session
# ends SESSION_MAX_DAYS after the password was typed, however often it is refreshed.
JWT_ACCESS_TTL_SEC=900
REFRESH_TTL_DAYS=7
SESSION_MAX_DAYS=30
# Per-account login backoff (Redis): free failures, then base*2^n seconds up to the max.
LOGIN_FREE_ATTEMPTS=5
LOGIN_BACKOFF_BASE_SEC=30
LOGIN_BACKOFF_MAX_SEC=900
# Proxies in front of the API that set X-Forwarded-For (0 = none, as in local dev; Caddy = 1).
TRUST_PROXY_HOPS=0

# local = files on this machine's disk; s3 = Cloudflare R2 / Backblaze B2 / MinIO
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
UPLOAD_TMP_DIR=./tmp/uploads
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_BUCKET=firstframe
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

VERIFIER_URL=http://localhost:8000

# mock = fake checkout for local demos; razorpay = real (use test keys first)
PAYMENTS_PROVIDER=mock
# RAZORPAY_KEY_ID=rzp_test_xxx
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
PLATFORM_FEE_PERCENT=30
# Days a sale's credit is held before it can be paid out (refund/chargeback window).
EARNINGS_HOLD_DAYS=7
# Hours payouts are blocked after the payout (UPI) details change.
PAYOUT_COOLDOWN_HOURS=24

# Used by `npm run db:seed` to create the first admin. The seed applies the same email rule as
# the login form (a TLD of letters only, e.g. not ".e2e"), so a seeded admin can always log in.
ADMIN_EMAIL=admin@firstframe.local
ADMIN_PASSWORD=change-this-admin-password
