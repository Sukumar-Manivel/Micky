# Copy to .env for local development: cp .env.example .env
NODE_ENV=development
PORT=4000
PUBLIC_API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

DATABASE_URL=postgresql://firstframe:firstframe@localhost:5432/firstframe
REDIS_URL=redis://localhost:6379

# Generate real secrets for production with: openssl rand -base64 48
JWT_ACCESS_SECRET=
SIGNING_SECRET=
INTERNAL_TOKEN=

# local = files on this machine's disk; s3 = Cloudflare R2 / Backblaze B2 / MinIO
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
UPLOAD_TMP_DIR=./tmp/uploads
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_BUCKET=firstframe
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

VERIFIER_URL=http://localhost:8000

# mock = fake checkout for local demos; razorpay = real (use test keys first)
PAYMENTS_PROVIDER=mock
# RAZORPAY_KEY_ID=rzp_test_xxx
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
PLATFORM_FEE_PERCENT=30

# Used by `npm run db:seed` to create the first admin
ADMIN_EMAIL=admin@firstframe.local
ADMIN_PASSWORD=change-this-admin-password
