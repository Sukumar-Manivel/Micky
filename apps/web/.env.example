# Micky web app environment. Copy to .env.local for `next dev`: cp .env.example .env.local
# Nothing here is secret: the web app only needs to know where the API is.

# --- Where the browser finds the API (origin only, no /api/v1, no trailing slash) ---

# Runtime value, read by /runtime-config.js on each request. Set this on the Docker container
# so one image can serve staging and production. Takes precedence over NEXT_PUBLIC_API_URL.
PUBLIC_API_URL=http://localhost:4000

# Build-time fallback, inlined into the JavaScript bundle by `next build`. Used when
# PUBLIC_API_URL is not set (and as the default in `next dev`). Pass it as a Docker build arg
# if you prefer to bake the address into the image.
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Standalone server (output: 'standalone') ---
# After `npm run build`:
#   cp -r public .next/standalone/ && cp -r .next/static .next/standalone/.next/
#   PORT=3000 HOSTNAME=0.0.0.0 PUBLIC_API_URL=https://api.example.com node .next/standalone/server.js
PORT=3000
HOSTNAME=0.0.0.0

# Opt out of Next.js anonymous telemetry in CI and containers.
NEXT_TELEMETRY_DISABLED=1

# The API must allow this site's origin: set WEB_URL / CORS_ORIGINS in apps/api/.env to the
# address people open the web app at (e.g. https://micky.in), or logins will fail on CORS.
