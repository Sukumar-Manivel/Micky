# Dependencies
node_modules/
.pnp
.pnp.js

# Builds
dist/
build/
.next/
out/
coverage/

# Environment and secrets (never commit these)
.env
.env.*
!.env.example
!.env.prod.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Local uploads and media (never commit videos)
/uploads/
/media/
*.mp4
*.mov
*.mkv

# Docker volumes
/data/
/pgdata/

# Editors and OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Local media storage and test output from the API
apps/api/storage/
apps/api/tmp/
storage/
tmp/

# Redis snapshot from a local redis-server
dump.rdb

# TypeScript incremental build info (generated on every build)
*.tsbuildinfo
